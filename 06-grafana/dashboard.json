{
  "__inputs": [
    {"name": "DS_VICTORIAMETRICS", "label": "VictoriaMetrics", "description": "Prometheus-compatible VictoriaMetrics datasource", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}
  ],
  "id": null,
  "uid": "kyverno-vm-observability",
  "title": "Kyverno Policy Observability",
  "description": "Kyverno admission and CEL image-validation metrics queried from VictoriaMetrics.",
  "tags": ["kyverno", "victoriametrics", "kubernetes", "cel"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Total Admission Requests (Selected Range)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum(increase(kyverno_admission_requests_total[$__range]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}},
    {"id": 2, "type": "stat", "title": "Allowed Requests (Selected Range)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum(increase(kyverno_admission_requests_total{request_allowed=\"true\"}[$__range]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}},
    {"id": 3, "type": "stat", "title": "Denied Requests (Selected Range)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum(increase(kyverno_admission_requests_total{request_allowed=\"false\"}[$__range]))", "instant": true, "range": false}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}},
    {"id": 4, "type": "timeseries", "title": "Admission Requests Over Time", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum by (request_allowed) (rate(kyverno_admission_requests_total[$__rate_interval]))", "legendFormat": "allowed={{request_allowed}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "type": "timeseries", "title": "Admission Requests by Operation", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum by (resource_request_operation) (rate(kyverno_admission_requests_total[$__rate_interval]))", "legendFormat": "{{resource_request_operation}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Admission Requests by Resource Kind", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum by (resource_kind) (rate(kyverno_admission_requests_total[$__rate_interval]))", "legendFormat": "{{resource_kind}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "Image Validation Results", "description": "Results from Kyverno CEL ImageValidatingPolicy; only populated if this metric is exposed and scraped.", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"}, "targets": [{"refId": "A", "expr": "sum by (policy_name, result) (rate(kyverno_image_validating_policy_results_total[$__rate_interval]))", "legendFormat": "{{policy_name}} / {{result}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}
